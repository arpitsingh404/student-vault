# Copy this file to server/.env and fill in a NEW key.
# Never commit server/.env and never paste the key into chat or the APK.
SV_AI_API_KEY=replace-with-a-new-deepseek-key
SV_AI_BASE_URL=https://api.deepseek.com/v1
SV_AI_MODEL=deepseek-chat
SV_API_TOKEN=replace-with-a-long-random-app-token
SV_ALLOWED_ORIGIN=*
